# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
# Julianne Bouchat




START hilow_game

IMPORT random number

OUTPUT "Welcome to the higher/lower game!"

ESTABLISH valid range

WHILE not in valid range:
    OUTPUT "Enter the lower bound: "
        GET lower bound from input
    OUTPUT "Enter the upper bound: "
        GET upper bound from input
    IF lower bound is lower than upper bound THEN:
        range is valid
    ELSE:
        OUTPUT "invalid"

GENERATE random number in valid range

OUTPUT "Guess a number between lower bound and upper bound: "
GET guess in valid range from input

    WHILE guess is not equal to random number:
        IF guess is lower than random number THEN:
            OUTPUT "Sorry, too low."
        IF ELSE guess is higher than random number THEN:
            OUTPUT "Sorry, too high."
        OUTPUT "Guess again."
        GET guess from input

OUTPUT "You got it!"
            
    

END hilow_game

